# --- Telegram ---
# Get from @BotFather. ROTATE any token that has ever been pasted into chat/logs.
TELEGRAM_BOT_TOKEN=PLACEHOLDER_TELEGRAM_BOT_TOKEN

# Your own numeric Telegram user ID -- message @userinfobot to get it. The bot only
# responds to this one ID; everyone else gets "This bot is private."
OWNER_TELEGRAM_USER_ID=PLACEHOLDER_OWNER_TELEGRAM_USER_ID

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
# Create a "Desktop app" OAuth client (not "Web application") -- no redirect URI needed.
GOOGLE_CLIENT_ID=PLACEHOLDER_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PLACEHOLDER_GOOGLE_CLIENT_SECRET

# Leave blank until you've run: python scripts/google_auth_setup.py
# That script signs you into Google once locally and prints the value to put here.
GOOGLE_REFRESH_TOKEN=

# --- Local state file (calendar Share/Private flags, daily agenda settings) ---
# On Railway, point this at a mounted Volume, e.g. /data/state.json, so it survives restarts.
STATE_FILE_PATH=./data/state.json

# How the bot addresses you in full-day briefs (/today, the nightly preview). Leave
# blank for a generic "there".
OWNER_GREETING_NAME=

# --- Webhook (Telegram pushes messages to this service instead of polling -- required
# for Railway's Serverless/sleep mode to actually save money) ---
# Public URL of this deployed service. Railway's generated domain in prod; an ngrok/
# Cloudflare tunnel URL for local testing.
PUBLIC_BASE_URL=https://PLACEHOLDER.up.railway.app
# Random secret Telegram echoes back on every webhook call, so we can reject requests
# that don't come from Telegram. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=PLACEHOLDER_WEBHOOK_SECRET

# --- Cron service auth ---
# Railway volumes attach to exactly one service, so the separate cron service has no
# persistent disk of its own -- it just POSTs to this service's /internal/tick, which
# runs the scheduled checks in-process here instead, against this service's own real
# state file. This secret guards that endpoint; set the SAME value on both services.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=PLACEHOLDER_INTERNAL_API_SECRET

# --- Gemini (AI event parsing -- optional but recommended) ---
# Comma-separated, up to 3 free-tier API keys from https://aistudio.google.com -- if the
# first key errors or hits its free-tier rate limit, the bot automatically tries the next
# one, then falls back to the local (non-AI) date parser if all of them fail. Leave blank
# to skip AI parsing entirely and always use the local parser.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash

# Optional, comma-separated first name + nicknames (e.g. "Alex,babe") -- the first
# name is used as her display name in girlfriend-related messages (e.g. "Alex's
# Schedule for tomorrow"; leave blank for a generic "Partner"), and the full list is
# used by /categorize's bulk backfill (events mentioning any of these get suggested as
# GF). New events are never auto-categorized -- you always pick the category yourself.
GIRLFRIEND_NAME=

# --- Girlfriend's calendar(s) (5pm summary, /gf, /gf_schedule) ---
# Option 1: her Google Calendar ID -- normally just her email. She must have already
# shared her calendar with your Google account at "See all event details" (not just
# free/busy) via Google Calendar's own sharing settings. Leave blank to skip this source.
GIRLFRIEND_EMAIL=

# Option 2: the exact name of a calendar you've subscribed to in Google Calendar
# (Settings > Add calendar > From URL) pointing at her HowAbout public calendar feed.
# Matched by name, not ID, since subscribed/ICS calendars don't have a predictable ID --
# resolved and cached automatically the next time the bot syncs your calendar list.
# Leave blank to skip this source. Both sources can be used together, and this one is
# preferred over Option 1 whenever both are configured.
GIRLFRIEND_HOWABOUT_CALENDAR_NAME=

# Either/both of the above are excluded from your own /today, /week, /next, /categorize.

# Her timezone -- used only by /gf_schedule_today, which shows each event's time in
# both her zone and yours (your /timezone setting) side by side. Defaults to UTC;
# set this for a meaningful dual-timezone display.
GIRLFRIEND_TIMEZONE=UTC

# --- /gf countdown ---
# Fixed dates, format YYYY-MM-DD (the actual/original date -- /gf computes the next
# upcoming occurrence from the month/day each time). Leave either blank and /gf will
# just say it isn't set rather than error.
PARTNER_BIRTHDAY_DATE=
ANNIVERSARY_DATE=

# --- HowAbout (future integration; safe to leave as placeholders for now) ---
HOWABOUT_API_KEY=PLACEHOLDER_HOWABOUT_API_KEY
HOWABOUT_BASE_URL=https://PLACEHOLDER.howabout.example/api
# Shown as a link in the nightly reminder. Left as this placeholder, that line is
# simply omitted from the message until you set a real URL.
HOWABOUT_APP_LINK=PLACEHOLDER_HOWABOUT_LINK
